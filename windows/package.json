{
  "name": "hoster-windows",
  "version": "1.2.0",
  "description": "Hoster — Local Wi-Fi File Sharing Desktop App (Windows)",
  "main": "main.js",
  "author": "Hoster",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bonjour-service": "^1.4.4",
    "express": "^4.19.2",
    "ip": "^2.0.1",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "multicast-dns": "^7.2.5",
    "music-metadata": "7.14.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "webdav-server": "^2.6.3",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hosterapp.desktop",
    "productName": "Hoster",
    "copyright": "MIT License",
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "src/**",
      "public/**",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
