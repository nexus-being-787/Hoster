{
  "name": "hoster",
  "version": "1.0.0",
  "description": "Host your mobile folders on local Wi-Fi for others to browse & download",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "sync": "node scripts/sync-copies.js",
    "sync:check": "node scripts/sync-copies.js --check"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bonjour-service": "^1.4.4",
    "express": "^4.19.2",
    "ip": "^2.0.1",
    "mime-types": "^3.0.2",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "7.14.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "webdav-server": "^2.6.3",
    "ws": "^8.17.1"
  },
  "keywords": [
    "android",
    "file-server",
    "local-network",
    "mobile",
    "nodejs-mobile",
    "react-native",
    "streaming",
    "vlc",
    "webdav",
    "wi-fi"
  ],
